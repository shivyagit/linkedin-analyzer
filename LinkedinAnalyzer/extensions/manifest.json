{
  "manifest_version": 3,
  "name": "LinkedIn Job Analyzer",
  "version": "1.0.0",
  "description": "Analyze LinkedIn job postings against your resume for match score, skills, and pitch.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"]
    }
  ]
}